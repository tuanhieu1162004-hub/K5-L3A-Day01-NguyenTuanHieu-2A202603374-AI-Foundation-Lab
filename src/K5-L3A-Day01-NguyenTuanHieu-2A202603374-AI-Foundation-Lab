        "# ⚙️ BỘ CÔNG CỤ CỦA LAB — chạy, KHÔNG sửa\n",
        "import os, re, time, json, hashlib, inspect, random\n",
        "from collections import Counter\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "assert STUDENT_ID.strip(), \"✋ Hãy điền STUDENT_ID ở ô phía trên rồi chạy lại ô này.\"\n",
        "SEED = int(hashlib.md5(STUDENT_ID.strip().encode()).hexdigest(), 16) % 10_000\n",
        "random.seed(SEED); np.random.seed(SEED)\n",
        "_LOG = {\"seed\": SEED, \"predictions\": {}, \"checks\": {}, \"experiments\": []}\n",
        "\n",
        "def predict(key: str, text: str):\n",
        "    \"\"\"Ghi dự đoán của bạn TRƯỚC khi chạy thí nghiệm.\"\"\"\n",
        "    if not text or \"...\" in text:\n",
        "        print(\"✋ Hãy viết dự đoán thật của bạn (không để trống / '...').\"); return\n",
        "    _LOG[\"predictions\"][key] = {\"text\": text, \"time\": time.strftime(\"%H:%M:%S\")}\n",
        "    print(f\"📝 Đã ghi dự đoán [{key}] lúc {_LOG['predictions'][key]['time']}\")\n",
        "\n",
        "def require_prediction(key: str):\n",
        "    if key not in _LOG[\"predictions\"]:\n",
        "        raise RuntimeError(f\"✋ Chưa có dự đoán! Chạy trước:  predict('{key}', 'dự đoán của bạn')\")\n",
        "    _LOG[\"experiments\"].append({\"key\": key, \"time\": time.strftime(\"%H:%M:%S\")})\n",
        "\n",
        "def _run_check(name, fn):\n",
        "    try:\n",
        "        fn(); _LOG[\"checks\"][name] = True; print(f\"✅ {name}\")\n",
        "    except NotImplementedError:\n",
        "        _LOG[\"checks\"][name] = False; print(f\"⬜ {name}: chưa làm\")\n",
        "    except AssertionError as e:\n",
        "        _LOG[\"checks\"][name] = False; print(f\"❌ {name}: {e}\")\n",
        "    except Exception as e:\n",
        "        _LOG[\"checks\"][name] = False; print(f\"❌ {name}: {type(e).__name__}: {e}\")\n",
        "\n",
        "def _no_sklearn(fn):\n",
        "    assert \"sklearn\" not in inspect.getsource(fn), f\"{fn.__name__} không được dùng sklearn — hãy tự code\"\n",
        "\n",
        "def benchmark(predict_texts, texts_batch, texts_single, warmup: int = 3):\n",
        "    \"\"\"Đo inference TỪ VĂN BẢN THÔ → NHÃN.\n",
        "    predict_texts: hàm list[str] → np.ndarray nhãn.\n",
        "    Trả về (preds của cả lô, {\"msg_per_s\": throughput cả lô, \"p50_ms\"/\"p95_ms\": latency khi gọi TỪNG tin}).\"\"\"\n",
        "    for t in list(texts_single)[:warmup]:\n",
        "        predict_texts([t])\n",
        "    t0 = time.perf_counter(); preds = np.asarray(predict_texts(list(texts_batch))); dt = time.perf_counter() - t0\n",
        "    lat = []\n",
        "    for t in texts_single:\n",
        "        s = time.perf_counter(); predict_texts([t]); lat.append((time.perf_counter() - s) * 1000)\n",
        "    return preds, {\"msg_per_s\": len(texts_batch) / dt, \"p50_ms\": float(np.percentile(lat, 50)), \"p95_ms\": float(np.percentile(lat, 95))}\n",
        "\n",
        "def fmt_bench(train_s, b):\n",
        "    return (f\"⏱ train {train_s:.1f}s · inference cả lô {b['msg_per_s']:,.{0 if b['msg_per_s'] >= 10 else 2}f} tin/s · \"\n",
        "            f\"từng tin p50 {b['p50_ms']:.2f} ms / p95 {b['p95_ms']:.2f} ms\")\n",
        "\n",
        "print(f\"✅ STUDENT_ID={STUDENT_ID}  →  SEED={SEED}\")"
      ]

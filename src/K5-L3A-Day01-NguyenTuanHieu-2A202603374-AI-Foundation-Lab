        "# 🧩 TODO 1.4 — Đánh giá: accuracy chưa đủ khi dữ liệu lệch!\n",
        "def metrics(y_true, y_pred) -> dict:\n",
        "    \"\"\"\n",
        "    Trả về {\"accuracy\", \"precision\", \"recall\", \"f1\"} (float). Lớp dương = spam (1).\n",
        "      precision = TP / (TP + FP)   — trong số tin bị chặn, bao nhiêu % là spam thật?\n",
        "      recall    = TP / (TP + FN)   — trong số spam thật, bắt được bao nhiêu %?\n",
        "      f1        = 2·P·R / (P + R)\n",
        "    Mẫu số = 0 → trả về 0.0 cho chỉ số đó.\n",
        "    \"\"\"\n",
        "    y_true = np.asarray(y_true)\n",
        "    y_pred = np.asarray(y_pred)\n",
        "    TP = np.sum((y_true == 1) & (y_pred == 1))\n",
        "    TN = np.sum((y_true == 0) & (y_pred == 0))\n",
        "    FP = np.sum((y_true == 0) & (y_pred == 1))\n",
        "    FN = np.sum((y_true == 1) & (y_pred == 0))\n",
        "    accuracy = (TP + TN) / len(y_true) if len(y_true) > 0 else 0.0\n",
        "    precision = TP / (TP + FP) if (TP + FP) > 0 else 0.0\n",
        "    recall = TP / (TP + FN) if (TP + FN) > 0 else 0.0\n",
        "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0\n",
        "\n",
        "    return {\n",
        "        \"accuracy\": float(accuracy),\n",
        "        \"precision\": float(precision),\n",
        "        \"recall\": float(recall),\n",
        "        \"f1\": float(f1)\n",

        "def train_mlp(model, X_tr, y_tr, X_va, y_va, epochs=15, lr=1e-3, batch_size=64):\n",
        "    opt = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    loss_fn = nn.BCEWithLogitsLoss()\n",
        "    Xt, yt = torch.tensor(X_tr), torch.tensor(y_tr, dtype=torch.float32)\n",
        "    Xv, yv = torch.tensor(X_va), torch.tensor(y_va, dtype=torch.float32)\n",
        "    hist = {\"train\": [], \"val\": []}\n",
        "    for ep in range(epochs):\n",
        "        model.train(); perm = torch.randperm(len(Xt)); total = 0.0\n",
        "        for i in range(0, len(Xt), batch_size):\n",
        "            idx = perm[i:i + batch_size]; xb, yb = Xt[idx], yt[idx]\n",
        "            opt.zero_grad()\n",
        "            logits = model(xb).squeeze(1)\n",
        "            loss = loss_fn(logits, yb)\n",
        "            loss.backward()\n",
        "            opt.step()\n",
        "            total += loss.item() * len(idx)\n",
        "        model.eval()\n",
        "        with torch.no_grad():\n",
        "            hist[\"val\"].append(loss_fn(model(Xv).squeeze(1), yv).item())\n",
        "        hist[\"train\"].append(total / len(Xt))\n",
        "    return hist\n",
        "\n",
        "def predict_mlp(model, X) -> np.ndarray:   # ⚙️ có sẵn\n",
        "    model.eval()\n",
        "    with torch.no_grad():\n",
        "        return (torch.sigmoid(model(torch.tensor(X)).squeeze(1)) >= 0.5).int().numpy()"
      ]

      "source": [
        "def bce_loss(y, p):   # ⚙️ có sẵn — binary cross-entropy, càng nhỏ càng tốt\n",
        "    p = np.clip(p, 1e-9, 1 - 1e-9)\n",
        "    return float(-np.mean(y * np.log(p) + (1 - y) * np.log(1 - p)))\n",
        "\n",
        "def train_logreg(X, y, lr: float = 0.5, epochs: int = 300):\n",
        "    \"\"\"Trả về (w, b, losses). w khởi tạo = 0 (shape = số cột của X), b = 0. len(losses) == epochs.\"\"\"\n",
        "    X = np.asarray(X, dtype=np.float64)   # (có sẵn) tính bằng float64 cho nhanh & ổn định\n",
        "    n, d = X.shape\n",
        "    w, b, losses = np.zeros(d), 0.0, []\n",
        "    for epoch in range(epochs):\n",
        "        p = predict_proba(X, w, b)\n",
        "        error = p - y\n",
        "        grad_w = X.T @ error / n\n",
        "        grad_b = np.mean(error)\n",
        "        w = w - lr * grad_w\n",
        "        b = b - lr * grad_b\n",
        "        losses.append(bce_loss(y, p))\n",
        "    return w, b, losses"
      ]
